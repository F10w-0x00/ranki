FROM debian:stretch-slim

ENV DEBIAN_FRONTEND=noninteractive

# Point apt to archive.debian.org for Debian Stretch and disable validity checks
RUN echo 'deb http://archive.debian.org/debian stretch main' > /etc/apt/sources.list && \
    echo 'deb http://archive.debian.org/debian-security stretch/updates main' >> /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until && \
    echo 'Acquire::AllowInsecureRepositories "true";' >> /etc/apt/apt.conf.d/99no-check-valid-until

# Multiarch setup for armel and install cross toolchain + ARMEL libraries
RUN dpkg --add-architecture armel && \
    apt-get -o Acquire::AllowInsecureRepositories=true -o Acquire::AllowDowngradeToInsecureRepositories=true update && \
    apt-get install -y --allow-unauthenticated --no-install-recommends \
        build-essential \
        gcc-arm-linux-gnueabi \
        g++-arm-linux-gnueabi \
        binutils-arm-linux-gnueabi \
        pkg-config \
        valac \
        automake \
        autoconf \
        libtool \
        protobuf-compiler \
        libgtk2.0-dev:armel \
        libwebkitgtk-dev:armel \
        libsoup2.4-dev:armel \
        libarchive-dev:armel \
        libsqlite3-dev:armel \
        ca-certificates \
        curl \
        git \
        python3 \
        patch \
        file && \
    rm -rf /var/lib/apt/lists/*

# Fix expired DST Root CA X3 certificate in Debian Stretch ca-certificates
RUN sed -i 's/mozilla\/DST_Root_CA_X3.crt/!mozilla\/DST_Root_CA_X3.crt/' /etc/ca-certificates.conf && \
    update-ca-certificates -f

# Install Rust & armel target (minimal profile for fast CI build)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup target add arm-unknown-linux-gnueabi

WORKDIR /workspace
CMD ["/bin/bash", "/workspace/tools/ci_build_armel.sh"]
